# cp .env.aws.example .env.aws   (git-ignored). Fill from `terraform output app_env`.
SECRET_KEY=change-me-to-a-long-random-string
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
RAW_BUCKET=
MEDIA_BUCKET=
CDN_BASE_URL=https://dxxxxxxxxxxxxx.cloudfront.net
CLOUDFRONT_KEY_PAIR_ID=
# One line, with \n for line breaks:
#   terraform output -raw cloudfront_private_key_pem | awk '{printf "%s\\n", $0}'
CLOUDFRONT_PRIVATE_KEY=
