# Copy to .env and adjust. docker compose reads this automatically.
APP_ENV=development
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string
S3_ACCESS_KEY=streamforge
S3_SECRET_KEY=streamforge-secret
# Signs playback URLs (edge + API must share it) and authenticates edge -> origin.
CDN_SIGNING_SECRET=change-me-too
CDN_ORIGIN_SECRET=change-me-as-well
